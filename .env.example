ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
DAYTONA_API_KEY=
# DAYTONA_API_URL=          # only if your account needs a non-default endpoint
SESSION_BPM_DEFAULT=90
# backend tuning (optional)
# MUSIC_MODEL=music_v2
# VERSION_MS=20000            # length of each version; shorter = faster
# CONDITION_MODE=short        # short | none | full  (see docs/APIS.md step 0 results)
# COND_INTRO_MS=3000          # short mode: conditioned intro length
# MAIN_ADHERENCE=low          # short mode: context_adherence of the main chunk
# CONDITION_STRENGTH=high     # low|medium|high|xhigh
SONG_ID_HEADER=song-id
# USE_CACHE=1                 # serve preset v1 from backend/cache/
# LOCAL_ANALYSIS_FALLBACK=1   # run analyse.py locally if Daytona is unavailable (dev only)
