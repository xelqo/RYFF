# Where the backend runs. Leave empty locally (defaults to http://localhost:8000).
# On Vercel set it in Project Settings -> Environment Variables, e.g. https://ryff-api.onrender.com
VITE_API_BASE=
# Only used by the fallback UI at /?classic (the conversational agent). Agent IDs are public, not secrets.
VITE_ELEVENLABS_AGENT_ID=
